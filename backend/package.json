{
  "name": "short-url-backend",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"tsx src/index.ts\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "db:setup": "psql \"$DATABASE_URL\" -f sql/schema.sql && psql \"$DATABASE_URL\" -f sql/seed.sql",
    "migrate": "psql \"$DATABASE_URL\" -f sql/schema.sql && psql \"$DATABASE_URL\" -f sql/seed.sql"
  },
  "engines": {
    "node": "20.x",
    "npm": "9.x"
  },
  "keywords": [],
  "author": "Krunal Patel",
  "license": "ISC",
  "description": "Short URL Redirect with React + Node.js + Express + PostgreSQL",
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.20.0",
    "nodemon": "^3.1.14",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3"
  }
}
